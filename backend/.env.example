# Kopieren nach backend/.env und Werte eintragen. backend/.env ist von Git ausgeschlossen.

# Exa: Credits aus dem Hackathon-Portal, Key unter dashboard.exa.ai
EXA_API_KEY=

# Gemini über Vertex AI – eine der beiden Varianten:
# a) Vertex-Express mit API-Schlüssel (teilbar im Team):
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_API_KEY=
# b) Google-Login (gcloud auth application-default login) mit Projekt:
#    Wird zusätzlich für die Google Places API (Umkreissuche) gebraucht.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Alternativen (optional)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_ANALYSE_MODEL=gemini-3.8-flash
LLM_TEXT_MODEL=gemini-3.8-flash

# 1 = keine externen Aufrufe, alles aus backend/cache/demo/
DEMO_MODE=0

FRONTEND_URL=http://localhost:5173

# E-Mail, wenn die Potenzialanalyse fertig ist (optional, z. B. SMTP des Vereins-Postfachs)
SMTP_HOST=
SMTP_PORT=587
SMTP_BENUTZER=
SMTP_PASSWORT=
SMTP_ABSENDER=

# Anmeldung: Secure-Cookie. Browser erlauben das auf http://localhost; in Produktion nur HTTPS.
COOKIE_SECURE=True
SITZUNG_TAGE=7
SITZUNG_LEERLAUF_STUNDEN=24
