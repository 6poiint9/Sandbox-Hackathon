# Kopieren nach backend/.env und Werte eintragen. backend/.env ist von Git ausgeschlossen.

# Exa: Credits aus dem Hackathon-Portal, Key unter dashboard.exa.ai
EXA_API_KEY=

# Sprachmodelle (siehe CLAUDE.md, Abschnitt "Externe Dienste")
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_ANALYSE_PROVIDER=gemini
LLM_ANALYSE_MODEL=
LLM_TEXT_PROVIDER=anthropic
LLM_TEXT_MODEL=claude-sonnet-5-5

# 1 = keine externen Aufrufe, alles aus backend/cache/demo/
DEMO_MODE=0

FRONTEND_URL=http://localhost:5173
